# PostgreSQL connection
# Leave empty to use the built-in local database (zero setup).
# For PostgreSQL: DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/excel_bus"
DATABASE_URL=
# Long random string — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"
# Operator timezone for display
APP_TIMEZONE="Asia/Kolkata"
# Public URL (used in WhatsApp share links / QR codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
